{
  "name": "agent-fault-lab",
  "version": "0.1.0",
  "description": "Reproducible chaos experiments for AI agents: inject real faults, inspect recovery, and detect duplicate side effects.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/cli.mjs serve",
    "dev": "node --watch src/cli.mjs serve",
    "demo": "node src/cli.mjs compare --scenario lost-response",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:e2e": "node scripts/browser-test.mjs"
  },
  "license": "MIT",
  "homepage": "https://github.com/KardeniaPoyu/agent-fault-lab#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/KardeniaPoyu/agent-fault-lab.git"
  },
  "bugs": {
    "url": "https://github.com/KardeniaPoyu/agent-fault-lab/issues"
  },
  "keywords": [
    "ai-agents",
    "chaos-engineering",
    "fault-injection",
    "idempotency",
    "resilience",
    "observability"
  ]
}
